---
import Base from '../layouts/Base.astro';
import { getNegocio } from '../data/content';
const n = await getNegocio();
---
<Base title={`Lista enviada | ${n.nombre}`} description="Recibimos tu lista." noindex>
  <section>
    <div class="wrap" style="max-width:640px;text-align:center">
      <div class="glass form no-print">
        <h1 style="font-size:clamp(2rem,6vw,3rem)">¡Gracias!</h1>
        <p style="margin-top:1rem" id="gtxt">{n.gracias_texto}</p>
        <div id="gwa"><p class="mut" style="margin-top:.8rem">Para agilizar, envía tu lista por WhatsApp:</p>
        <p style="margin-top:1.2rem"><a id="wa" class="btn btn-wa" href={`https://wa.me/${n.whatsapp}`} target="_blank" rel="noopener">Abrir WhatsApp con mi lista</a></p></div>
        <p class="mut" style="margin-top:1.2rem">Cuando recibas tu cotización, <a href="/como-pagar" style="text-decoration:underline">mira aquí las cuentas para depositar</a>.</p>
        <p id="gnum" hidden style="margin-top:1rem;font-size:1.2rem;font-weight:700"></p>
        <p id="gpdfw" hidden style="margin-top:1rem"><button id="gpdf" type="button" class="btn btn-wa">Descargar mi pedido (PDF)</button></p>
        <p style="margin-top:1.2rem"><a class="btn btn-g" href="/catalogo">Seguir viendo productos</a></p>
      </div>
      <div id="gprint" class="print-only" aria-hidden="true"></div>
    </div>
  </section>
  <script>
    try { const w = window as any; if (w.fbq) w.fbq('track', 'Lead'); if (w.ttq) w.ttq.track('SubmitForm'); if (w.gtag) w.gtag('event', 'generate_lead'); } catch {}
    try { if (sessionStorage.getItem('pzs_cerrado')) { sessionStorage.removeItem('pzs_cerrado'); document.getElementById('gwa')!.hidden = true; document.getElementById('gtxt')!.textContent = 'Tu pedido quedó cerrado y registrado. Tu asesor lo atenderá y te contactará.'; } } catch {}
    try {
      const num = sessionStorage.getItem('pzs_num'), html = sessionStorage.getItem('pzs_pdfhtml');
      if (num && html) {
        document.getElementById('gnum')!.textContent = 'Pedido N° ' + num; document.getElementById('gnum')!.hidden = false;
        document.getElementById('gprint')!.innerHTML = html; document.getElementById('gpdfw')!.hidden = false;
        document.getElementById('gpdf')!.addEventListener('click', () => { const a = document.title; document.title = 'Pedido ' + num + ' - PROLIMSO Zona Sur'; const v = () => { document.title = a; window.removeEventListener('afterprint', v); }; window.addEventListener('afterprint', v); window.print(); });
      }
    } catch {}
    try {
      const u = sessionStorage.getItem('pzs_wa');
      if (u && u.startsWith('https://wa.me/')) { (document.getElementById('wa') as HTMLAnchorElement).href = u; sessionStorage.removeItem('pzs_wa'); location.href = u; }
    } catch {}
  </script>
</Base>
