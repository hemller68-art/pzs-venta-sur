    const variante = (n: string) => { for (const r of VARIANTES) { const m = n.match(r); if (m) { const c = m[2].trim().replace(/^colores\s+/i, ''); return { m: m[1].trim(), c: c.charAt(0).toUpperCase() + c.slice(1) }; } } return null; };
