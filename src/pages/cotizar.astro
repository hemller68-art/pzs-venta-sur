---
import Base from '../layouts/Base.astro';
import { getNegocio } from '../data/content';
import { CIUDADES, TIPOS_NEGOCIO } from '../data/validar';
import { getProductos, getCuentas } from '../data/content';
const cuentas = (await getCuentas()).map((c) => ({ b: c.banco, t: c.titular, e: c.etiqueta, n: c.numero, c: c.cci }));
const n = await getNegocio();
const buscable = (await getProductos()).map((p) => ({ s: p.slug, n: p.nombre, f: p.foto_url, u: p.unidades_empaque, b: p.bulto_emp || 0, q: p.consultar ? 1 : 0, e: p.empaque_nombre || 'empaque', c: (p.codigos || []).join(' '), o: p.colores || '' }));
---
<Base title={`Cotiza tu pedido | ${n.nombre}`} description="Ingresa tu RUC o DNI, elige tus productos y colores y envía tu pedido por WhatsApp." noindex>
  <section>
    <div class="wrap" style="max-width:760px">
      <h1 style="font-size:clamp(2rem,6vw,3.2rem)">Cotiza tu pedido</h1>
      <p class="aviso" style="margin-top:1rem">{n.aviso_minimo}</p>

      <div id="gate" class="glass gate">
        <h2>1. Ingresa con tu RUC o DNI</h2>
        <p class="hint">Es obligatorio para armar tu cotización.</p>
        <form id="gf" class="f dos" novalidate>
          <div class="full seg" role="radiogroup" aria-label="Tipo de documento">
            <label><input type="radio" name="gt" value="RUC" checked /> RUC</label>
            <label><input type="radio" name="gt" value="DNI" /> DNI</label>
          </div>
          <label class="full">Número <input name="gn" inputmode="numeric" maxlength="11" autocomplete="off" required /></label>
          <label class="full">Clave de cliente (solo si ya eres cliente de PROLIMSO) <input name="gc" inputmode="numeric" maxlength="6" autocomplete="off" placeholder="6 dígitos (opcional)" /></label>
          <p class="hint full" style="margin:0">¿Eres cliente y no tienes tu clave? Pídesela a tu asesor por WhatsApp. Si aún no eres cliente, déjala en blanco.</p>
          <p class="err full" id="gerr" role="alert"></p>
          <button class="btn btn-gold full" id="gbtn" type="submit">Continuar</button>
        </form>
      </div>

      <div id="paso" hidden>
        <div class="glass idok"><span id="idtxt"></span><button class="btn btn-g btn-s" id="cambiar" type="button">Cambiar</button></div>

        <div id="datos" class="glass form" style="margin-bottom:1rem">
          <h2 id="h2d" style="font-size:1.4rem;margin-bottom:1rem">2. Tus datos</h2>
          <div class="f dos">
            <label class="full" data-nc><span id="lbl-nombre">Razón social</span> <input form="form" name="nombre" maxlength="120" autocomplete="organization" required /></label>
            <label data-nc>Persona de contacto <input form="form" name="contacto" maxlength="80" autocomplete="name" /></label>
            <label data-nc>WhatsApp <input form="form" name="whatsapp" type="tel" inputmode="numeric" maxlength="12" placeholder="9XXXXXXXX" autocomplete="tel" required /></label>
            <label data-nc>Ciudad <select form="form" name="ciudad" required><option value="">Elige…</option>{CIUDADES.map((c) => <option>{c}</option>)}</select></label>
            <label id="otra" data-nc hidden>¿Cuál? <input form="form" name="ciudad_otra" maxlength="60" /></label>
            <label data-nc>Tipo de negocio <select form="form" name="tipo_negocio" required><option value="">Elige…</option>{TIPOS_NEGOCIO.map((c) => <option>{c}</option>)}</select></label>
            <h3 class="full" id="h3ag" style="font-size:1.1rem;margin-top:.6rem">Agencia de envío (opcional)</h3>
            <label><span id="lbl-ag">Nombre de la agencia</span> <input form="form" name="ag_nombre" maxlength="80" list="dl-ag" autocomplete="off" /><datalist id="dl-ag"></datalist></label>
            <label data-nc>RUC de la agencia <input form="form" name="ag_ruc" inputmode="numeric" maxlength="11" autocomplete="off" /></label>
            <label class="full"><span id="lbl-agc">Contacto de la agencia (teléfono o persona)</span> <input form="form" name="ag_contacto" maxlength="80" autocomplete="off" /></label>
            <label class="full" data-c hidden>Condición de pago <select form="form" name="condicion"><option value="">Elige…</option><option value="contado">Contado</option><option value="factura">Crédito con factura</option><option value="letra">Crédito con letra</option></select></label>
            <label class="chk full" data-nc><input form="form" type="checkbox" name="consent" /> Acepto que PROLIMSO use mis datos para enviarme la cotización y contactarme. <a href="/privacidad" style="text-decoration:underline">Política de privacidad</a></label>
          </div>
          <p class="err" id="errd" role="alert"></p>
        </div>

        <div class="glass buscador">
          <label for="q">3. BUSCA TU PRODUCTO</label>
          <input id="q" type="search" aria-label="Buscar producto por nombre o código" placeholder="Escribe el nombre o código (ej. cesto, canasta, tacho)" autocomplete="off" />
          <div id="res" class="res" aria-live="polite"></div>
        </div>
        <script type="application/json" id="cat" set:html={JSON.stringify(buscable).replace(/</g, '\\u003c')}></script>
        <div id="ultimo" class="glass" hidden style="padding:.7rem 1rem;margin-bottom:.8rem;flex-wrap:wrap;gap:.6rem;align-items:center;justify-content:space-between"></div>
        <div id="edit"></div>
        <script type="application/json" id="ctas" set:html={JSON.stringify(cuentas).replace(/</g, '\\u003c')}></script>

        <h2 style="font-size:1.4rem;margin:1.6rem 0 .6rem">4. Mi pedido</h2>
        <div id="abierto" class="glass" hidden style="display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;justify-content:space-between;padding:.7rem 1rem;margin-bottom:.8rem;border:1px solid var(--gold)"><span id="abtxt" style="font-weight:700"></span><span style="display:flex;gap:.5rem;flex-wrap:wrap"><button class="btn btn-gold btn-s" id="cerrarped" type="button" hidden>Cerrar pedido</button><button class="btn btn-g btn-s" id="nuevoped" type="button">Nuevo pedido</button></span></div>
        <div id="lista" class="lista-v" aria-live="polite"></div>
        <div id="print" class="print-only" aria-hidden="true"></div>
        <div id="vacio" class="glass vacio"><p>Aún no agregaste productos. Búscalos arriba o entra al <a href="/catalogo" style="text-decoration:underline">catálogo</a>.</p></div>
        <p id="tot" class="hint" style="margin:.8rem 0" hidden></p>
        <p id="ptot" hidden style="margin:.4rem 0 1rem;font-size:1.25rem;font-weight:700"></p>
        <p id="pdesc" hidden style="margin:-.6rem 0 1rem;font-size:1.15rem;font-weight:700;color:#ffd24a"></p>
        <p id="pnota" class="hint" hidden></p>
        <p id="pdfwrap" hidden style="margin-bottom:1rem"><button class="btn btn-g btn-s" id="pdf" type="button">Guardar mi lista en PDF</button></p>

        <form id="form" class="glass form" novalidate hidden>
          <h2 id="h4" style="font-size:1.4rem;margin-bottom:1rem">5. Enviar pedido</h2>
          <div class="f dos">
            <label class="full">Observaciones (opcional) <textarea name="observaciones" maxlength="500"></textarea></label>
            <input class="hp" name="web" tabindex="-1" autocomplete="off" aria-hidden="true" />
          </div>
          <p class="err" id="err" role="alert"></p>
          <button class="btn btn-wa" id="enviar" type="submit" style="width:100%;margin-top:.4rem">Enviar mi pedido por WhatsApp</button>
        </form>
      </div>
    </div>
  </section>
  <script>
    import { leer, ponerLinea, quitar, vaciar, suma, totales, MAX } from '../lib/lista';
    import type { Linea } from '../lib/lista';
    import { rucValido, dniValido } from '../data/validar';
    import { aplicarEscala, bonosPedido, ventaMin } from '../lib/escala';
    import { claveModelo } from '../data/grupos';
    import type { Bonif } from '../lib/escala';
    const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
    const el = <K extends keyof HTMLElementTagNameMap>(t: K, props: Record<string, unknown> = {}, ...kids: (Node | string)[]) => { const e = Object.assign(document.createElement(t), props); e.append(...kids); return e; };
    const t0 = Date.now();
    const CAT: { s: string; n: string; f: string; u: number; b: number; q: number; e: string; c: string; o: string }[] = JSON.parse(document.getElementById('cat')!.textContent || '[]');
    const UNICO = 'Único';
    const opciones = (p: { o: string }) => { const o = (p.o || '').split(/,|\/|\sy\s/).map((t) => t.trim()).filter(Boolean); return o.length >= 2 ? o : [UNICO]; };
    const fmt = (n: number) => n.toLocaleString('es-PE');
    const precioTxt = (slug: string, u: number, e: string) => { const pr = precioDe(slug); if (!pr) return ''; const b0 = aplicarEscala(pr as any, u, 1); let t = `${S(b0.u)} c/u x ${u} = ${S(b0.e)} por ${e}`; let ant = b0.u; const pm: string[] = []; [...(pr.esc || [])].sort((a, b) => a.d - b.d).forEach((x) => { const f = aplicarEscala(pr as any, u, x.d); if (f.u < ant) { pm.push(`desde ${x.d} emp. ${S(f.u)} c/u`); ant = f.u; } }); if (pm.length) t += '\nPromoción: ' + pm.join(' · '); return t; };
    const LIM = (s: string) => s.replace(/^\s*·\s*/, '');
    const plural = (n: number, w: string) => (n === 1 ? w : w + 's');
    // "12k" = 12 000, "1,5k" = 1 500, "250000" = 250 000
    function leerCant(t: string): number {
      let s = t.toLowerCase().replace(/\s/g, ''); if (!s) return 0;
      const k = /k$/.test(s); s = s.replace(/k$/, '');
      if (k) s = s.replace(',', '.'); else s = s.replace(/[.,]/g, '');
      const n = Number(s); if (!isFinite(n) || n <= 0) return 0;
      return Math.min(MAX, Math.floor(k ? n * 1000 : n));
    }

    // ---- Paso 1: documento ----
    type Id = { ult?: any; t: 'RUC' | 'DNI'; n: string; c?: string; nom?: string; cp?: boolean; l?: string; dc?: number; pr?: Record<string, { u: number | null; e: number; esc?: Array<{ d: number; x?: number; u?: number }> | null; g?: string | null; bon?: Bonif | null }> };
    const KID = 'pzs_id_v1';
    const getId = (): Id | null => { try { const x = JSON.parse(sessionStorage.getItem(KID) || 'null'); if (x && (x.t === 'RUC' ? rucValido(x.n) : x.t === 'DNI' && dniValido(x.n))) return x; } catch {} return null; };
    let ID: Id | null = getId();
    const gf = $<HTMLFormElement>('#gf');
    gf.addEventListener('change', () => { const t = (new FormData(gf).get('gt') as string); (gf.elements.namedItem('gn') as HTMLInputElement).maxLength = t === 'RUC' ? 11 : 8; });
    gf.addEventListener('submit', async (e) => {
      e.preventDefault();
      const v = new FormData(gf), t = v.get('gt') === 'DNI' ? 'DNI' : 'RUC', n = String(v.get('gn') || '').replace(/\D/g, ''), c = String(v.get('gc') || '').replace(/\D/g, '');
      if (t === 'RUC' ? !rucValido(n) : !dniValido(n)) { $('#gerr').textContent = t === 'RUC' ? 'El RUC no es válido (11 dígitos).' : 'El DNI debe tener 8 dígitos.'; return; }
      if (String(v.get('gc') || '').trim() && c.length !== 6) { $('#gerr').textContent = 'La clave tiene 6 dígitos.'; return; }
      $('#gerr').textContent = '';
      let nuevo: Id = { t, n };
      if (c) {
        const b = $<HTMLButtonElement>('#gbtn'); b.disabled = true; b.textContent = 'Verificando…';
        try {
          const r = await fetch('/api/acceso', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ doc: n, clave: c }) });
          const d = await r.json();
          if (!r.ok || !d.ok) { $('#gerr').textContent = d.error || 'Documento o clave incorrectos.'; b.disabled = false; b.textContent = 'Continuar'; return; }
          nuevo = { t, n, c, nom: d.nombre, cp: !!d.conPrecios, l: String(d.lista || ''), dc: Number(d.dc) || 0, ult: d.ultimo || null, pr: d.precios || {} };
        } catch { $('#gerr').textContent = 'Sin conexión. Intenta de nuevo.'; b.disabled = false; b.textContent = 'Continuar'; return; }
        b.disabled = false; b.textContent = 'Continuar';
      }
      ID = nuevo;
      try { sessionStorage.setItem(KID, JSON.stringify(ID)); } catch {}
      entrar();
    });
    $('#cambiar').addEventListener('click', () => { ID = null; try { sessionStorage.removeItem(KID); } catch {} $('#paso').hidden = true; $('#gate').hidden = false; });
    function entrar() {
      if (!ID) return;
      $('#gate').hidden = true; $('#paso').hidden = false;
      // La lista pertenece a un solo documento: si entra otro cliente, se empieza con una lista vacía.
      // Pedido abierto: sigue ahí hasta que se envíe o se pulse "Nuevo pedido". Si entra OTRO cliente, no se mezclan: se pide cerrar el pedido abierto.
      try {
        const KD = 'pzs_lista_dueno'; const d = localStorage.getItem(KD);
        if (d && d !== ID.n && leer().length) {
          const nl = leer().length;
          if (!confirm(`Hay un pedido abierto sin enviar del documento ${d} con ${nl} ${nl === 1 ? 'producto' : 'productos'}.\n\n¿Descartarlo y empezar un pedido nuevo para ${ID.n}?\n\nSi quieres conservarlo, pulsa Cancelar e ingresa de nuevo con el documento ${d} para enviarlo.`)) {
            ID = null; try { sessionStorage.removeItem(KID); } catch {} $('#paso').hidden = true; $('#gate').hidden = false; $('#gerr').textContent = `Hay un pedido abierto del documento ${d}. Ciérralo primero (envíalo) o descártalo.`; return;
          }
          vaciar(); limpiarForm();
        }
        if (d !== ID.n) localStorage.setItem(KD, ID.n);
      } catch { vaciar(); }
      $('#idtxt').textContent = `${ID.t}: ${ID.n}` + (ID.c ? ` · Cliente${ID.nom ? ': ' + ID.nom : ''}` : '');
      $('#lbl-nombre').textContent = ID.t === 'RUC' ? 'Razón social' : 'Nombre completo';
      // Cliente de cartera (entra con clave): sus datos ya están registrados; solo se pide transporte, observaciones y condición de pago.
      const car = !!ID.c;
      document.querySelectorAll<HTMLElement>('[data-nc]').forEach((e) => { if (car) e.style.setProperty('display', 'none', 'important'); else e.style.removeProperty('display'); });
      document.querySelectorAll<HTMLElement>('[data-c]').forEach((e) => { e.hidden = false; e.style.display = car ? '' : 'none'; });
      $('#h2d').textContent = car ? '2. Tus datos de envío' : '2. Tus datos';
      $('#h4').textContent = car ? '5. Cerrar pedido' : '5. Enviar pedido';
      $('#h3ag').textContent = car ? 'Transporte' : 'Agencia de envío (opcional)';
      $('#lbl-ag').textContent = car ? 'Agencia de transportes (obligatorio)' : 'Nombre de la agencia';
      $('#lbl-agc').textContent = car ? 'Datos del transportista (nombre, teléfono, destino)' : 'Contacto de la agencia (teléfono o persona)';
      $('#enviar').textContent = car ? 'Cerrar pedido' : 'Enviar mi pedido por WhatsApp';
      $('#cerrarped').hidden = !car; $('#nuevoped').textContent = car ? 'Descartar pedido' : 'Nuevo pedido';
      pintar(); restaurarForm();
      if (car && ID.ult) {
        const u = ID.ult, setv = (k: string, v: string) => { const e = f.elements.namedItem(k) as HTMLInputElement | null; if (e && v && !e.value) e.value = v; };
        setv('ag_nombre', u.agencia || ''); setv('ag_contacto', u.datos || ''); setv('condicion', u.condicion || '');
        pintar();
      }
      pintarUltimo(); cargarTransportes();
      const p = new URLSearchParams(location.search).get('p');
      if (p) { const prod = CAT.find((x) => x.s === p); if (prod) abrir(prod); try { const u = new URL(location.href); u.searchParams.delete('p'); history.replaceState(null, '', u.pathname + (u.search || '') + u.hash); } catch {} }
    }

    // ---- Agencias de transporte (solo cartera): lista desplegable con búsqueda y datos autocompletados ----
    let TRM: Record<string, string> = {}, TRL = new Map<string, string>();
    async function cargarTransportes() {
      if (!ID || !ID.c) return;
      try {
        const r = await fetch('/api/transportes', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ doc: ID.n, clave: ID.c }) });
        const d = await r.json();
        TRM = d.mis || {}; TRL = new Map((d.lista || []).map((x: string[]) => [String(x[0]).toUpperCase(), String(x[1] || '')]));
        const dl = document.getElementById('dl-ag')!; dl.replaceChildren(...(d.lista || []).map((x: string[]) => { const o = document.createElement('option'); o.value = x[0]; return o; }));
      } catch {}
    }
    const agIn = () => f.elements.namedItem('ag_nombre') as HTMLInputElement, agcIn = () => f.elements.namedItem('ag_contacto') as HTMLInputElement;
    function autoDatos() {
      if (!ID || !ID.c) return;
      const k = agIn().value.trim().toUpperCase(), c = agcIn();
      if (!k || (c.value.trim() && c.dataset.auto !== '1')) return;
      const v = TRM[k] || TRL.get(k) || '';
      if (v || c.dataset.auto === '1') { c.value = v; c.dataset.auto = v ? '1' : ''; guardarForm(); }
    }

    // ---- Repetir el último pedido (solo cartera) ----
    function lineasDe(u: any): Array<{ s: string; cols: Record<string, number> }> {
      const out: Array<{ s: string; cols: Record<string, number> }> = [];
      for (const it of Array.isArray(u?.items) ? u.items : []) {
        const cols: Record<string, number> = {};
        if (Array.isArray(it.cols) && it.cols.length) for (const c of it.cols) cols[String(c.color || UNICO)] = (cols[String(c.color || UNICO)] || 0) + (Number(c.qty) || 0);
        else if (it.color) for (const par of String(it.color).split(',')) { const m = par.trim().match(/^(\d+)\s+(.+)$/); if (m) cols[m[2]] = (cols[m[2]] || 0) + Number(m[1]); }
        else cols[UNICO] = Number(it.empaques) || 0;
        out.push({ s: String(it.slug), cols });
      }
      return out;
    }
    function pintarUltimo() {
      const box = $('#ultimo'); box.replaceChildren();
      const u = ID && ID.c ? ID.ult : null;
      if (!u || !Array.isArray(u.items) || !u.items.length) { box.hidden = true; box.style.display = 'none'; return; }
      const fch = u.fecha ? new Date(u.fecha).toLocaleDateString('es-PE') : '';
      const sp = el('span', { textContent: `Tu último pedido ${u.numero || ''} ${fch ? '(' + fch + ')' : ''} · ${u.items.length} ${u.items.length === 1 ? 'producto' : 'productos'}`, style: 'font-weight:700' });
      const b = el('button', { type: 'button', className: 'btn btn-g', textContent: 'Repetir este pedido' });
      b.addEventListener('click', () => {
        if (leer().length && !confirm('Se reemplazará el pedido abierto por tu último pedido. ¿Continuar?')) return;
        vaciar();
        let omitidos = 0;
        for (const l of lineasDe(u)) {
          const p = CAT.find((x) => x.s === l.s);
          if (!p) { omitidos++; continue; }
          ponerLinea({ slug: p.s, nombre: p.n + (p.q ? ' (consultar disponibilidad)' : ''), foto: p.f, uemp: p.u }, l.cols);
        }
        pintar();
        if (omitidos) alert(`${omitidos} ${omitidos === 1 ? 'producto ya no está disponible y se omitió' : 'productos ya no están disponibles y se omitieron'}.`);
        document.getElementById('lista')!.scrollIntoView({ behavior: 'smooth' });
      });
      box.append(sp, b); box.hidden = false; box.style.display = 'flex';
    }

    // ---- Precios (solo clientes de cartera verificados) ----
    const S = (n: number) => 'S/ ' + n.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const conPrecios = () => !!(ID && ID.c && ID.cp);
    // Infantas no tiene venta mínima por empaques (solo Lista 1 y visitantes).
    const bm = (b: number) => (ID?.l && /infantas/i.test(ID.l) ? 0 : b);
    const precioDe = (slug: string) => (conPrecios() ? ID!.pr?.[slug] : undefined);
    // Precio final según la cantidad de paquetes (descuento por escala: solo puede bajar el precio).
    const precioN = (slug: string, uemp: number, paq: number) => { const pr = precioDe(slug); return pr ? aplicarEscala(pr as any, uemp, paq) : null; };
    // Paquetes que cuentan para la escala: del producto o, si tiene grupo, de todos los de su grupo (colores de un mismo modelo).
    const paqDe = (x: Linea) => { const g = precioDe(x.slug)?.g; return g ? leer().reduce((a, l) => a + (precioDe(l.slug)?.g === g ? suma(l) : 0), 0) : suma(x); };
    const subtotal = (x: Linea) => { const f = precioN(x.slug, x.uemp, paqDe(x)); return f ? suma(x) * f.e : null; };
    // Bonificación (regalo a S/ 0.00 por cada N paquetes): no cambia el precio, solo agrega unidades gratis.
    const bonDe = (slug: string) => (conPrecios() ? precioDe(slug)?.bon : null);
    const nomDe = (slug: string) => CAT.find((c) => c.s === slug)?.n || slug;
    const avisoBon = (slug: string) => { const b = bonDe(slug); if (!b || !b.cada) return ''; return ` · Bonificación: ${b.uni} unid. de regalo por cada ${b.cada} ${b.base === 'u' ? 'unidades' : b.cada === 1 ? 'paquete' : 'paquetes'}${b.grupo ? ' (se suman las presentaciones)' : ''}${b.rs && b.rs !== slug ? ' · el regalo es ' + nomDe(b.rs) : ''}`; };
    const bonosDe = (ls: Linea[]) => (conPrecios() ? bonosPedido(ls.map((x) => ({ slug: x.slug, empaques: suma(x), unidades: suma(x) * x.uemp })), bonDe) : []);
    const textoBonos = (ls: Linea[]) => bonosDe(ls).map((b) => ` + ${fmt(b.uni)} unid. de BONIFICACIÓN de ${nomDe(b.slug)} (S/ 0.00)`).join('');
    const pUnid = (slug: string, uemp: number, paq = 1) => { const f = precioN(slug, uemp, paq); return f ? f.u : null; };
    const avisoEscala = (slug: string, uemp: number) => { const pr = precioDe(slug); if (!pr?.esc?.length) return ''; const base = aplicarEscala(pr as any, uemp, 1).u; const t = [...pr.esc].sort((a, b) => a.d - b.d).find((x) => aplicarEscala(pr as any, uemp, x.d).u < base); return t ? ` · Descuento por volumen: desde ${t.d} ${t.d === 1 ? 'paquete' : 'paquetes'} baja el precio${pr.g ? ' (se suman todos los colores del modelo)' : ''}` : ''; };

    // ---- Paso 2/3: buscar y editar producto ----
    const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    function buscar() {
      const q = norm((document.getElementById('q') as HTMLInputElement).value.trim()), cont = $('#res');
      if (q.length < 2) { cont.replaceChildren(); return; }
      const ws = q.split(/\s+/);
      const vistos = new Set<string>();
