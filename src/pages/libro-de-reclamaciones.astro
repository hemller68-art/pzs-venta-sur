---
import Base from '../layouts/Base.astro';
import { getNegocio } from '../data/content';
const n = await getNegocio();
---
<Base title={`Libro de Reclamaciones | ${n.nombre}`} description="Registra tu reclamo o queja en nuestro Libro de Reclamaciones virtual." noindex>
  <section><div class="wrap" style="max-width:820px">
    <h1 style="font-size:clamp(2rem,6vw,3rem)">Libro de Reclamaciones</h1>
    <p class="mut" style="margin-top:.6rem">Conforme al Código de Protección y Defensa del Consumidor, registra aquí tu reclamo o queja.</p>

    <div class="glass form" style="margin-top:1rem" id="prov">
      <p><strong>Sitio web operado por:</strong> {n.legal_razon}{n.legal_ruc && ` · RUC ${n.legal_ruc}`}{n.legal_direccion && ` · ${n.legal_direccion}`}</p>
      <p style="margin-top:.4rem"><strong>Proveedor de los productos y comprobantes de pago:</strong> {n.prov_razon}{n.prov_ruc && ` · RUC ${n.prov_ruc}`}</p>
      <p class="hint" style="margin-top:.6rem">{n.legal_razon} gestiona las cotizaciones y pedidos como representante comercial de {n.prov_razon}. Tu reclamo se registra con ambos datos y recibirás una constancia con tu código.</p>
    </div>

    <form id="rf" class="glass form" novalidate style="margin-top:1rem">
      <h2 style="font-size:1.3rem;margin-bottom:1rem">1. Identificación del consumidor</h2>
      <div class="f dos">
        <label class="full">Nombres y apellidos <input name="nombre" maxlength="160" autocomplete="name" required /></label>
        <label>Tipo de documento <select name="doc_tipo" required><option value="DNI">DNI</option><option value="CE">Carné de extranjería</option><option value="RUC">RUC</option><option value="Pasaporte">Pasaporte</option></select></label>
        <label>Número de documento <input name="doc_num" maxlength="20" autocomplete="off" required /></label>
        <label class="full">Domicilio <input name="domicilio" maxlength="250" autocomplete="street-address" required /></label>
        <label>Teléfono o celular <input name="telefono" type="tel" maxlength="20" autocomplete="tel" /></label>
        <label>Correo electrónico <input name="email" type="email" maxlength="120" autocomplete="email" required /></label>
        <label class="chk full"><input type="checkbox" name="menor_edad" id="menor" /> Soy menor de edad (se requiere padre, madre o apoderado)</label>
        <label class="full" id="apo" hidden>Nombre del padre, madre o apoderado <input name="apoderado" maxlength="160" /></label>
      </div>

      <h2 style="font-size:1.3rem;margin:1.4rem 0 1rem">2. Identificación del bien contratado</h2>
      <div class="f dos">
        <label>Tipo <select name="bien"><option value="producto">Producto</option><option value="servicio">Servicio</option></select></label>
        <label>Monto reclamado (S/, opcional) <input name="monto" inputmode="decimal" maxlength="30" /></label>
        <label class="full">Descripción (producto, cotización o pedido) <input name="descripcion_bien" maxlength="500" /></label>
      </div>

      <h2 style="font-size:1.3rem;margin:1.4rem 0 1rem">3. Detalle del reclamo o queja</h2>
      <div class="f dos">
        <label class="full">Tipo <select name="tipo"><option value="reclamo">Reclamo (disconformidad con el producto o servicio)</option><option value="queja">Queja (malestar por la atención recibida)</option></select></label>
        <label class="full">Detalle <textarea name="detalle" maxlength="3000" required></textarea></label>
        <label class="full">Pedido del consumidor (qué solución esperas) <textarea name="pedido_consumidor" maxlength="2000" required></textarea></label>
        <input class="hp" name="web" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="chk full"><input type="checkbox" name="consent" /> Acepto que {n.legal_razon} y {n.prov_razon} usen mis datos para atender este reclamo. <a href="/privacidad" style="text-decoration:underline">Política de privacidad</a></label>
      </div>
      <p class="hint" style="margin-top:.8rem">La formulación del reclamo no impide acudir a otras vías de solución de controversias ni es requisito previo para interponer una denuncia ante el INDECOPI. El proveedor debe dar respuesta en un plazo no mayor a treinta (30) días calendario.</p>
      <p class="err" id="err" role="alert"></p>
      <button class="btn btn-gold" id="env" type="submit" style="width:100%;margin-top:.4rem">Enviar reclamo</button>
    </form>

    <div id="ok" class="glass form" hidden style="margin-top:1rem;text-align:center">
      <h2 style="font-size:1.5rem">Reclamo registrado</h2>
      <p style="margin-top:.6rem">Tu código es <strong id="cod" style="font-size:1.4rem"></strong></p>
      <p class="mut" id="cor" style="margin-top:.6rem"></p>
      <p style="margin-top:1rem"><button class="btn btn-g" id="imp" type="button">Guardar mi constancia en PDF</button></p>
    </div>
  </div></section>
  <script>
    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const f = $('#rf') as HTMLFormElement, t0 = Date.now();
    ($('#menor') as HTMLInputElement).addEventListener('change', (e) => { $('#apo').hidden = !(e.target as HTMLInputElement).checked; });
    const mal = (campo: string | undefined, t: string) => { $('#err').textContent = t; (f.elements.namedItem(campo || '') as HTMLElement | null)?.focus(); };
    let constancia = '';
    f.addEventListener('submit', async (e) => {
      e.preventDefault(); $('#err').textContent = '';
      const v = new FormData(f);
      const body = Object.fromEntries([...v.entries()].filter(([k]) => !['menor_edad', 'consent'].includes(k)));
      Object.assign(body, { menor_edad: v.get('menor_edad') === 'on', consent: v.get('consent') === 'on', t: t0 });
      const b = $('#env') as HTMLButtonElement; b.disabled = true; b.textContent = 'Enviando…';
      try {
        const r = await fetch('/api/reclamo', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
        const d = await r.json();
        if (!r.ok || !d.ok) { mal(d.campo, d.error || 'No se pudo enviar. Intenta de nuevo.'); return; }
        $('#cod').textContent = d.codigo;
        $('#cor').textContent = d.correo ? 'También enviamos una copia a tu correo.' : 'Guarda tu código y tu constancia en PDF. Te responderemos al correo o teléfono que indicaste.';
        constancia = `<h1>Hoja de Reclamación ${d.codigo}</h1><p>${new Date().toLocaleString('es-PE')}</p><p>${($('#prov') as HTMLElement).innerText.replace(/\n/g, '<br>')}</p><p><b>Consumidor:</b> ${String(body.nombre)} · ${String(body.doc_tipo)} ${String(body.doc_num)}<br>${String(body.domicilio)} · ${String(body.email)}</p><p><b>${body.tipo === 'queja' ? 'Queja' : 'Reclamo'}</b> sobre ${body.bien === 'servicio' ? 'servicio' : 'producto'}: ${String(body.descripcion_bien || '')}</p><p><b>Detalle:</b> ${String(body.detalle)}</p><p><b>Pedido del consumidor:</b> ${String(body.pedido_consumidor)}</p>`.replace(/<(?!\/?(h1|p|b|br)\b)[^>]*>/gi, '');
        f.hidden = true; ($('#ok') as HTMLElement).hidden = false; $('#ok').scrollIntoView({ behavior: 'smooth' });
      } catch { mal(undefined, 'Sin conexión. Intenta de nuevo.'); } finally { b.disabled = false; b.textContent = 'Enviar reclamo'; }
    });
    $('#imp').addEventListener('click', () => {
      const w = window.open('', '_blank'); if (!w) return;
      w.document.write(`<!doctype html><meta charset="utf-8"><title>Constancia de reclamo</title><style>body{font:14px/1.5 Arial,sans-serif;margin:28px;color:#000}h1{font-size:20px}</style><body>${constancia}</body>`);
      w.document.close(); setTimeout(() => { w.focus(); w.print(); }, 400);
    });
  </script>
</Base>
